# Copia este archivo a android/keystore.properties y rellena tus claves.
# Genera el keystore con JDK 21 (el alias debe coincidir con keyAlias):
#   keytool -genkeypair -v -keystore android/opios-release.jks -alias opios \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# GUARDA el .jks y este archivo FUERA del repo: ambos están en .gitignore y, si se
# pierden, no podrás firmar la siguiente actualización con la misma identidad.
storeFile=opios-release.jks
storePassword=CAMBIAME
keyAlias=opios
keyPassword=CAMBIAME
