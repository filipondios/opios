# Copia este archivo a `.env` (Bun lo carga automáticamente) y ajusta lo que necesites.

# Carpeta del banco de preguntas.
# Si no se define, se usa `./ejemplo` (o `./preguntas` si tu banco está ahí).
# Si la defines y la carpeta no existe, la app avisa y no arranca.
# OPIOS_PREGUNTAS=./ejemplo

# Importación al arrancar: `vacia` (solo si la base de datos no tiene preguntas),
# `auto` (en cada arranque, con --actualizar) o `no` (nunca).
# OPIOS_SEED=auto

# Modo de la app en PC:
# - Modo directo (por defecto): un solo banco. Sin definir nada, se usa data/opios.db.
#   OPIOS_DB=data/opios.db
# - Modo biblioteca (varios bancos, pestaña "Bancos" y copias): define OPIOS_DATOS
#   con una carpeta; el catálogo y los bancos viven ahí (catalogo.db y *.db).
#   OPIOS_DATOS=./mis-datos
# - Alternativa antigua: ruta exacta al archivo de catálogo, en vez de OPIOS_DATOS.
#   OPIOS_CATALOGO=data/biblioteca.db
# En biblioteca, elige el banco activo con:
#   bun run bancos listar
#   bun run bancos importar "Mi banco" ./ejemplo
#   bun run bancos activar 1

# APP_TZ=Europe/Madrid
# PORT=8000
# HOST=127.0.0.1
# OPIOS_AVISO_VERSION=1        # 0 desactiva el aviso de versión nueva
# AUTH_USER=usuario
# AUTH_PASS=clave
# ALLOWED_HOSTS=192.168.1.50
