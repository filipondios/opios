# Copia este archivo a `.env` (Bun lo carga automáticamente) y ajusta lo que necesites.

# Carpeta del banco de preguntas.
# Por defecto: `./preguntas` si existe; si no, el banco de ejemplo `./ejemplo`.
# Si la defines y la carpeta no existe, la app avisa y no arranca.
OPIOS_PREGUNTAS=./opios-bank

# Importación al arrancar: `vacia` (solo si la base de datos no tiene preguntas),
# `auto` (en cada arranque, con --actualizar) o `no` (nunca).
# OPIOS_SEED=auto

# Opcionales
# PORT=8000
# HOST=127.0.0.1
# OPIOS_DB=data/opios.db
# APP_TZ=Europe/Madrid
# AUTH_USER=usuario
# AUTH_PASS=clave
# ALLOWED_HOSTS=192.168.1.50
